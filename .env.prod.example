# Copy to .env.prod and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d
#
# Every value below has no safe default in production — docker compose will
# refuse to start until it's set.

# Real domain this deployment is reachable at. Caddy uses this both to route
# requests and to request a Let's Encrypt certificate automatically (only
# works for a real public domain with ports 80/443 reachable from the
# internet — leave as "localhost" only for a local smoke test of this
# compose file, which will serve plain HTTP with no TLS).
DOMAIN=localhost

# Long, random value — e.g. `openssl rand -hex 32`. Rotating it invalidates
# all existing sessions.
JWT_SECRET=

# Postgres credentials for the db container.
POSTGRES_USER=apex_cycling
POSTGRES_PASSWORD=
POSTGRES_DB=apex_cycling

# Cookies are only sent over HTTPS when true. Set to false only if smoke
# testing this compose file over plain HTTP at DOMAIN=localhost.
COOKIE_SECURE=true
