# Production settings. Normally generated for you:
#   scripts/init-env.sh <domain> <letsencrypt-email>
# which copies this file to .env.prod and fills in the required values
# (DOMAIN, ACME_EMAIL, JWT_SECRET, DATA_ENCRYPTION_KEY, POSTGRES_PASSWORD) with fresh secrets.
# .env.prod holds secrets: keep it out of git (it is ignored) and mode 600.

# ── Required ───────────────────────────────────────────────────────────────

# Public hostname of the app. Caddy requests a Let's Encrypt certificate for
# it, which needs a DNS A record (and no AAAA record) pointing at the server
# and ports 80 + 443 reachable from the internet. "localhost" gives a private-CA
# certificate and is only for smoke-testing this stack on your own machine.
DOMAIN=localhost

# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=

# Long random value (`openssl rand -hex 32`). Rotating it signs everyone out.
JWT_SECRET=

# Encrypts the third-party credentials kept in the database (Strava tokens,
# Intervals.icu API keys). 32 url-safe base64 bytes: `openssl rand -base64 32
# | tr + - | tr / _`. Back it up WITH this file: a database restore onto a
# server with a different key leaves those connections unreadable (users would
# reconnect them). To rotate, put the new key first and keep the old one after
# a comma ("new,old") until every connection has been saved again.
DATA_ENCRYPTION_KEY=

# Database password (`openssl rand -hex 24`). Only read when the database is
# first created: changing it later does not change the existing database.
POSTGRES_PASSWORD=

# ── Defaults you rarely change ─────────────────────────────────────────────

POSTGRES_USER=apex_cycling
POSTGRES_DB=apex_cycling

# Auth cookies are only sent over HTTPS. Leave true for any real domain; set
# false only to smoke-test over plain HTTP.
COOKIE_SECURE=true

# Public URL, used in password-reset links. Defaults to https://$DOMAIN.
# APP_BASE_URL=https://apex.example.com

# HSTS lifetime in seconds. Set 0 for a localhost smoke test so browsers
# don't pin https on localhost.
# HSTS_MAX_AGE=31536000

# Host ports the edge publishes (only change if something else uses them).
# HTTP_PORT=80
# HTTPS_PORT=443

# How often the background worker polls sqorz for active transponders.
# SQORZ_POLL_INTERVAL_MINUTES=20

# ── Optional email (password resets) ───────────────────────────────────────
# Leave SMTP_HOST empty to keep email off: admins then hand out reset links
# (`docker compose -f docker-compose.prod.yml --env-file .env.prod exec backend python -m app.auth.cli reset-link <email>`).
# Any SMTP provider works (OVH email, Brevo, Mailgun, SES…); use the port 587
# / starttls settings it gives you.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls (587), ssl (465) or none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ApexCycling <noreply@example.com>

# ── Backups (the `backup` service) ─────────────────────────────────────────

# Where dumps are kept on the host.
# BACKUP_DIR=/var/backups/apex-cycling
# Hour of day (container timezone, see TZ) the daily backup runs, and how
# many daily / weekly copies to keep.
# BACKUP_HOUR=3
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# TZ=America/Toronto
# Optional off-host copy of the backup directory to any S3-compatible store
# (OVH Object Storage, Backblaze B2, AWS S3). Strongly recommended: backups on
# the same disk don't survive losing the server. See README, "Backups".
# BACKUP_S3_URI=s3://my-bucket/apex-cycling
# BACKUP_S3_ENDPOINT=https://s3.<region>.io.cloud.ovh.net   # leave empty for AWS S3
# BACKUP_S3_REGION=<region>
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
