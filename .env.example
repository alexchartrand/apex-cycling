# Copy to .env and adjust for local overrides (docker-compose reads this automatically).
# All values below have working dev defaults baked into docker-compose.yml —
# only uncomment/set what you need to change.

# Must be a long, random value in anything beyond local dev.
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment

# Postgres credentials for the db container.
# POSTGRES_USER=apex_cycling
# POSTGRES_PASSWORD=apex_cycling
# POSTGRES_DB=apex_cycling

# Host ports, if the defaults clash with something else on your machine.
# DB_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173

# Origins allowed to call the backend directly, as a JSON array string. The
# SPA itself goes through the Vite /api proxy (same origin), so this only
# matters for tools hitting the backend port from a browser.
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Auth cookies default to Secure (HTTPS-only). Dev over plain HTTP needs this
# set to false; never set it to false in a real deployment.
# COOKIE_SECURE=false
