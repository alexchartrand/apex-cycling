# Copy to .env and adjust for local overrides (docker-compose reads this automatically).
# All values below have working dev defaults baked into docker-compose.yml —
# only uncomment/set what you need to change.

# Must be a long, random value in anything beyond local dev.
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment

# Postgres credentials for the db container.
# POSTGRES_USER=apex_cycling
# POSTGRES_PASSWORD=apex_cycling
# POSTGRES_DB=apex_cycling

# Host ports, if the defaults clash with something else on your machine.
# DB_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173

# Origins allowed to call the backend directly, as a JSON array string. The
# SPA itself goes through the Vite /api proxy (same origin), so this only
# matters for tools hitting the backend port from a browser.
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Auth cookies default to Secure (HTTPS-only). Dev over plain HTTP needs this
# set to false; never set it to false in a real deployment.
# COOKIE_SECURE=false

# Public URL of the app, used in password-reset links.
# APP_BASE_URL=http://localhost:5173

# Optional outgoing email (password resets). Leave SMTP_HOST unset to keep
# email off: users then get a reset link from an admin instead
# (`python -m app.auth.cli reset-link <email>` in the backend container).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls (587), ssl (465) or none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ApexCycling <noreply@example.com>

# Optional Web Push for notifications. Make a pair with
#   docker compose exec backend python -m app.notifications.cli generate-vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Strava (optional): an API application from https://www.strava.com/settings/api
# with callback domain "localhost". Without these the Strava connection is off.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Webhooks need Strava to reach the backend, so only with a public tunnel.
# STRAVA_WEBHOOK_VERIFY_TOKEN=

# AI coach (optional): an API key for the selected provider (Mistral at
# console.mistral.ai, or Anthropic). Without it the AI coach is off; with it a
# platform admin enables it per athlete in /admin.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-4
# MISTRAL_REASONING_EFFORT=medium   # low / medium / high
# AI_COACH_PROVIDER=mistral          # mistral / anthropic — switching asks every athlete to consent again
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium            # low / medium / high / xhigh / max
# AI_COACH_DEFAULT_MONTHLY_TOKENS=2000000
